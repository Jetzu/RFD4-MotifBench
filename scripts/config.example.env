# Environment used by the scripts in this directory. Copy to config.env, fill in, then `source config.env`.
# All machine-specific locations of the original runs were replaced by these variables.

export MBR4_ROOT=/path/to/this/project          # working dir: in/, runs/, logs/, deliverables/
export MOTIFBENCH_DIR=/path/to/MotifBench        # clone of https://github.com/blt2114/MotifBench (incl. Scaffold-Lab)
export MOTIFBENCH_ENV=/path/to/conda/envs/motif_bench   # conda env from MotifBench's motif_bench.yml
export FOLDSEEK_DB_DIR=/path/to/foldseek_database      # `foldseek databases PDB pdb tmp` output dir
export PASCAL_TORCH_OVERLAY=/path/to/torch280_cu126    # only for sm_61 GPUs: pip install --target ... torch==2.8.0 (cu126 index)

# RFD4-Proteina
export RFD4_SIF=/path/to/rfd4-proteina-cu128.sif       # Apptainer image of RFD4-Proteina (torch 2.11 / CUDA 12.8)
export RFD4_WEIGHTS_DIR=/path/to/rfd4-proteina-weights # contains bundle/ (HF revision a06e2509)
export BIND_PATHS=/data,/scratch                       # comma-separated paths the container must see
export APPTAINER=apptainer
export RFD4_REPO=/path/to/RFD4-Proteina                # source at commit ed63183a (Modal image build only)
export RFD4_PIP_FREEZE=/path/to/pip_freeze.txt         # pip freeze of a working RFD4 cu128 env (Modal image build only)

# Modal (optional, for the Modal evaluation / generation apps)
export MODAL_BIN_DIR=/path/to/venv/bin                 # venv with `pip install modal`

# Comparison figures
export RFD3_RESULTS_DIR=/path/to/RFD3/results          # ExpertGuess_Fixed/ and Unindexed_Fixed/ (RFD3 triplicates)
